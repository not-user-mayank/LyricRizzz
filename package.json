{
  "name": "lyricrizzz",
  "version": "0.1.0-beta.2",
  "description": "Floating lyrics widget for Windows",
  "main": "src/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.lyricrizzz.app",
    "productName": "Lyricrizzz",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "themes/themes.json",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/windows-media-sessions/bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "windows-media-sessions": "^1.0.3"
  }
}
